@@ -498,7 +504,10 @@ def compare(face1, face2):
 def estimate_age_onnx(face): 
     """
     Estimates the age of a person based on a facial encoding using ONNX model.
+
     :param face: dlibs 128-long face encoding
+    :return: ONNX Runtime output. ``result[0][0]`` is the estimated age
+        group, an index into `phantom.faces.age_tags`
     """
     (age_model, input_names) = lazy_vars.get("age_model_onnx")
     return age_model.run(None, {input_names[0]: [face.astype(np.float32)]})
@@ -531,5 +540,15 @@ def estimate_gender(face):
     return gender_model(vector)
 
 def estimate_gender_onnx(face):
+    """
+    Estimates the gender of a person based on a facial encoding using ONNX
+    model.
+
+    :param face: dlibs 128-long face encoding
+    :return: ONNX Runtime output. ``result[0][0][0]`` is the estimated
+        gender as a float, with the same meaning as in `estimate_gender`:
+        close to 1 for females, close to -1 for males, and values near 0
+        when the model is uncertain
+    """
     (gender_model, input_names) = lazy_vars.get("gender_model_onnx")
     return gender_model.run(None, {input_names[0]: [face.astype(np.float32)]})
