From 6e77b45b2645bfac73c4470136e318778a422a12 Mon Sep 17 00:00:00 2001
From: Matias Alvarez <alvarezjosematias1@gmail.com>
Date: Tue, 24 Nov 2026 14:24:17 +0000
Subject: [PATCH 3/3] fix: lucy_richardson_deconv gave wrong results for
 float32 and uint8

cv2.divide() was called with a preallocated output array and its return
value discarded. OpenCV only writes into that array when its dtype
already matches the requested one (float64), so:

- float32 images: the ratio was never computed and the result decayed
  towards black (about -96% of total intensity after 10 iterations).
- uint8 images: the first update used the input image instead of the
  ratio. Later updates partially corrected it, but results still
  differed from the correct ones (up to 12 levels after 10 iterations).

float64 images were not affected. Also fix the function's docstring: it
started with four quotes, named the sigmag parameter as sigma and did not
document clip.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Mz3p7Zh2aCyeTMP13T2zSu
---
 phantom/enhance.py | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/phantom/enhance.py b/phantom/enhance.py
index 23954db..8e6a0fa 100644
--- a/phantom/enhance.py
+++ b/phantom/enhance.py
@@ -28,13 +28,19 @@ def _clip(img, lower, higher):
 
 
 def lucy_richardson_deconv(img, num_iterations, sigmag, *, clip=True):
-    """"
-    Lucy-Richardson Deconvolution.
-
-    :param img: cv2/np.darray imge
-    :param num_iterations: number of iterations
-    :param sigma: sigma of (Gaussian) point spread function (PSF)
-    :return: deconvolution result
+    """
+    Lucy-Richardson deconvolution, assuming a Gaussian point spread function.
+
+    :param img: cv2/np.ndarray image. Supported types are uint8, uint16, and
+        floats in the [0, 1] range
+    :param num_iterations: number of iterations. The algorithm performs
+        `num_iterations - 1` updates
+    :param sigmag: standard deviation, in pixels, of the Gaussian point spread
+        function (PSF). `int(8 * sigmag + 1)` must be odd: multiples of 0.25
+        are always valid
+    :param clip: currently ignored, the result is always clipped to the valid
+        range of the input type
+    :return: take a guess
     """
 
     epsilon = 2.2204e-16
@@ -87,7 +93,10 @@ def lucy_richardson_deconv(img, num_iterations, sigmag, *, clip=True):
         re_blurred = cv2.GaussianBlur(y, (int(win_size), int(win_size)), sigmag)
         re_blurred[(re_blurred <= 0)] = epsilon
 
-        cv2.divide(w_i, re_blurred, im_r, 1, cv2.CV_64F)
+        # assign the result: cv2.divide only writes into an existing array
+        # when its dtype already matches, which is not the case for
+        # uint8 or float32 inputs
+        im_r = cv2.divide(w_i, re_blurred, None, 1, cv2.CV_64F)
         im_r = im_r + epsilon
 
         # applying Gaussian filter
